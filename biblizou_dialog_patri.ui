  <property name="styleSheet">
   <string notr="true">/* --- 1. FONDS ET CONTENEUR PRINCIPAL --- */
QDialog {
    background-color: #fcfcfc;
}

/* --- 2. GROUPES DE SÉLECTION GÉNÉRAUX (QGroupBox) --- */
QGroupBox {
    font-weight: bold;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    margin-top: 10px;
    padding: 10px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #2c3e50;
}

/* Style spécifique pour les sous-groupes imbriqués (hors listes rouges) */
QGroupBox#gBDirHabAnnexes {
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: rgba(0, 0, 0, 0.01);
    margin-top: 4px;
    padding: 4px;
}

/* --- 3. BLOC LISTES ROUGES ULTRA-COMPACT --- */
QGroupBox#gBListesRouges {
    padding: 0px;
}

/* Force l'espacement vertical interne de la grille à zéro */
QGroupBox#gBListesRouges QGridLayout {
    vertical-spacing: 0px;
    margin: 0px;
}

QGroupBox#gBListeRougeMond, 
QGroupBox#gBListeRougeEuro, 
QGroupBox#gBListeRougeNat, 
QGroupBox#gBListeRougeReg {
    padding-left: 145px; 
    margin-top: -4px;    /* Resserrement vertical extrême */
    margin-bottom: -4px;
    min-height: 16px;    /* Hauteur calée sur la taille de l'indicateur */
    max-height: 16px;    
    border: none;
    background-color: transparent;
}

/* Indicateurs de pliage des sous-groupes */
QGroupBox#gBListeRougeMond::indicator,
QGroupBox#gBListeRougeEuro::indicator,
QGroupBox#gBListeRougeNat::indicator,
QGroupBox#gBListeRougeReg::indicator {
    subcontrol-origin: padding;
    subcontrol-position: center left;
    left: 0px;
    width: 12px;
    height: 12px;
}

/* Titres des sous-groupes */
QGroupBox#gBListeRougeMond::title,
QGroupBox#gBListeRougeEuro::title,
QGroupBox#gBListeRougeNat::title,
QGroupBox#gBListeRougeReg::title {
    font-weight: normal;
    color: #2c3e50;
    font-size: 11px;
    subcontrol-origin: padding;
    subcontrol-position: center left;
    left: 16px; 
    padding: 0px;
}

/* En-tête des colonnes (LC, NT...) */
QGroupBox#groupBox_5 {
    padding-left: 145px; 
    border: none;
    background-color: transparent;
    margin-top: 0px;
    margin-bottom: -8px; /* Colle l'en-tête contre la première ligne */
}

QGroupBox#groupBox_5 QLabel {
    font-weight: bold;
    color: #555555;
    font-size: 10px;
    min-width: 24px;
    max-width: 24px;
    qproperty-alignment: 'AlignCenter';
}

/* Alignement et taille des cases à cocher */
QGroupBox#gBListeRougeMond QCheckBox,
QGroupBox#gBListeRougeEuro QCheckBox,
QGroupBox#gBListeRougeNat QCheckBox,
QGroupBox#gBListeRougeReg QCheckBox {
    min-width: 24px;
    max-width: 24px;
    margin: 0px;
    padding: 0px;
}

QGroupBox#gBListesRouges QCheckBox::indicator {
    subcontrol-origin: padding;
    subcontrol-position: center;
}

/* --- 4. STYLE UNIQUE DES INDICATEURS --- */
QCheckBox::indicator, QGroupBox::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover, QGroupBox::indicator:hover {
    border: 1px solid #3D8C70;
    background-color: rgba(61, 140, 112, 0.05);
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background-color: #3D8C70;
    border: 1px solid #3D8C70;
    image: url(:/plugins/biblizou/misc/arrowDown.png);
}

QCheckBox::indicator:disabled, QGroupBox::indicator:disabled {
    border: 1px solid rgba(0, 0, 0, 0.1);
    background-color: rgba(0, 0, 0, 0.05);
}

/* --- 5. ADAPTATION PETITS ÉCRANS --- */
@media (max-width: 400px) {
    QGroupBox {
        margin-top: 4px;
        padding: 4px;
    }
    QGroupBox#gBListeRougeMond, 
    QGroupBox#gBListeRougeEuro, 
    QGroupBox#gBListeRougeNat, 
    QGroupBox#gBListeRougeReg,
    QGroupBox#groupBox_5 {
        padding-left: 110px;
    }
    QGroupBox#groupBox_5 QLabel,
    QGroupBox#gBListeRougeMond QCheckBox,
    QGroupBox#gBListeRougeEuro QCheckBox,
    QGroupBox#gBListeRougeNat QCheckBox,
    QGroupBox#gBListeRougeReg QCheckBox {
        min-width: 20px;
        max-width: 20px;
    }
}</string>
